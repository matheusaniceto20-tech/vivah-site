---
---

<section id="orcamento" class="py-20 md:py-28 bg-vivah-green-dark-2">
	<div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
		<div class="text-center mb-10">
			<h2 class="font-display font-extrabold text-3xl md:text-4xl">Peça seu orçamento</h2>
			<p class="mt-3 text-white/70">Preenche os campos abaixo, a gente entra em contato rapidinho.</p>
		</div>

		<form
			name="orcamento"
			method="POST"
			data-netlify="true"
			netlify-honeypot="bot-field"
			action="/obrigado"
			class="bg-vivah-green-dark rounded-2xl p-6 md:p-8 border border-white/10 space-y-4"
		>
			<input type="hidden" name="form-name" value="orcamento" />
			<p class="hidden">
				<label>Não preencha isso: <input name="bot-field" /></label>
			</p>

			<div>
				<label for="nome" class="block text-sm font-medium text-white/80 mb-1">Nome</label>
				<input
					type="text" id="nome" name="nome" required
					class="w-full rounded-xl bg-white/5 border border-white/20 px-4 py-3 focus:outline-none focus:border-vivah-lime"
				/>
			</div>

			<div class="grid sm:grid-cols-2 gap-4">
				<div>
					<label for="telefone" class="block text-sm font-medium text-white/80 mb-1">Telefone / WhatsApp</label>
					<input
						type="tel" id="telefone" name="telefone" required
						class="w-full rounded-xl bg-white/5 border border-white/20 px-4 py-3 focus:outline-none focus:border-vivah-lime"
					/>
				</div>
				<div>
					<label for="email" class="block text-sm font-medium text-white/80 mb-1">E-mail</label>
					<input
						type="email" id="email" name="email"
						class="w-full rounded-xl bg-white/5 border border-white/20 px-4 py-3 focus:outline-none focus:border-vivah-lime"
					/>
				</div>
			</div>

			<div>
				<label for="mensagem" class="block text-sm font-medium text-white/80 mb-1">Mensagem</label>
				<textarea
					id="mensagem" name="mensagem" rows="4"
					placeholder="Conta um pouco sobre o que você precisa (residencial, empresarial, valor da conta de luz...)"
					class="w-full rounded-xl bg-white/5 border border-white/20 px-4 py-3 focus:outline-none focus:border-vivah-lime"
				></textarea>
			</div>

			<button
				type="submit"
				class="w-full bg-vivah-yellow text-vivah-green-dark font-bold px-6 py-3.5 rounded-full hover:brightness-95 transition"
			>
				Enviar pedido de orçamento
			</button>
		</form>
	</div>
</section>
