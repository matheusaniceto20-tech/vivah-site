---
import { Image, getImage } from 'astro:assets';
import { Images, ChevronLeft, ChevronRight, X } from 'lucide-static';
import { projetos, categorias, rotuloCategoria } from '../data/projetos';

const cards = await Promise.all(
	projetos.map(async (p) => ({
		...p,
		galeria: await Promise.all(
			p.fotos.map(async (foto) => (await getImage({ src: foto, width: 1400, format: 'webp', quality: 80 })).src)
		),
	}))
);
// projetos com depoimento/avaliação aparecem primeiro — reforça prova social logo de cara
cards.sort((a, b) => Number(!!b.avaliacao) - Number(!!a.avaliacao));
---

<section id="projetos" class="py-20 md:py-28 bg-vivah-mist scroll-mt-20">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="text-center max-w-2xl mx-auto" data-reveal>
			<span class="eyebrow">Projetos</span>
			<h2 class="titulo-secao">Obras <span class="marker">entregues</span> pela Vivah</h2>
			<p class="mt-4 text-vivah-muted">Clica num projeto pra ver as fotos da obra.</p>
		</div>

		<div class="mt-8 flex flex-wrap justify-center gap-2" role="tablist" aria-label="Filtrar projetos" data-reveal>
			{
				categorias.map((c, i) => (
					<button
						type="button"
						role="tab"
						aria-selected={i === 0 ? 'true' : 'false'}
						data-filtro={c.id}
						class="rounded-full bg-white px-5 py-2 text-sm font-semibold text-vivah-ink ring-1 ring-black/10 transition hover:ring-vivah-green aria-selected:bg-vivah-green aria-selected:text-white aria-selected:ring-vivah-green"
					>
						{c.rotulo} <span class="opacity-60">{c.total}</span>
					</button>
				))
			}
		</div>

		<ul class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
			{
				cards.map((p, i) => (
					<li data-categoria={p.categoria} data-reveal style={`--reveal-delay:${(i % 3) * 100}ms`}>
						<article class="group relative h-full flex flex-col overflow-hidden rounded-3xl bg-white ring-1 ring-black/5 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-2xl">
							<div class="relative aspect-[4/3] overflow-hidden">
								<Image
									src={p.fotos[0]}
									alt={`Projeto ${p.titulo}${p.local ? ' em ' + p.local : ''}`}
									widths={[480, 800]}
									sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
									class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
								/>
								<span class="absolute left-3 top-3 rounded-full bg-white/90 px-3 py-1 text-xs font-bold text-vivah-green">
									{rotuloCategoria[p.categoria]}
								</span>
								<span class="absolute right-3 bottom-3 inline-flex items-center gap-1.5 rounded-full bg-vivah-green/85 px-3 py-1 text-xs font-semibold text-white [&>svg]:h-4 [&>svg]:w-4">
									<Fragment set:html={Images} />
									{p.fotos.length} fotos
								</span>
							</div>
							<div class="flex flex-1 flex-col p-5">
								<h3 class="font-display font-bold text-xl text-vivah-ink">{p.titulo}</h3>
								{p.local && <p class="text-sm text-vivah-muted">{p.local}</p>}
								{p.specs.length > 0 && (
									<div class="mt-3 flex flex-wrap gap-2">
										{p.specs.map((s) => (
											<span class="rounded-full bg-vivah-yellow-100 px-3 py-1 text-xs font-semibold text-vivah-green-700">{s}</span>
										))}
									</div>
								)}
								{p.avaliacao && (
									<blockquote class="mt-4 border-l-4 border-vivah-yellow pl-3 text-sm text-vivah-muted">
										<span class="block text-vivah-star" aria-hidden="true">
											★★★★★
										</span>
										"{p.avaliacao}"
										<span class="mt-1 block text-xs font-semibold text-vivah-ink">Avaliação no Google</span>
									</blockquote>
								)}
							</div>
							<button
								type="button"
								class="absolute inset-0 rounded-3xl focus-visible:outline-4 focus-visible:outline-vivah-yellow"
								aria-label={`Ver as ${p.fotos.length} fotos do projeto ${p.titulo}`}
								data-galeria={JSON.stringify(p.galeria)}
								data-titulo={p.titulo + (p.local ? ' · ' + p.local : '')}
							>
							</button>
						</article>
					</li>
				))
			}
		</ul>
	</div>

	<dialog
		id="galeria"
		class="m-auto w-[min(1100px,94vw)] max-h-[94vh] overflow-hidden rounded-2xl bg-vivah-green p-0 text-white backdrop:bg-black/85"
	>
		<div class="flex items-center justify-between gap-4 px-4 py-3">
			<p id="galeria-titulo" class="font-display font-bold text-lg"></p>
			<div class="flex items-center gap-3">
				<span id="galeria-contador" class="text-sm text-white/70"></span>
				<button
					type="button"
					data-fechar
					aria-label="Fechar"
					class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 hover:bg-white/20 [&>svg]:h-5 [&>svg]:w-5"
				>
					<Fragment set:html={X} />
				</button>
			</div>
		</div>
		<div class="relative flex items-center justify-center bg-black">
			<img id="galeria-foto" alt="" class="max-h-[80vh] w-auto max-w-full object-contain" />
			<button
				type="button"
				data-anterior
				aria-label="Foto anterior"
				class="absolute left-2 top-1/2 -translate-y-1/2 flex h-11 w-11 items-center justify-center rounded-full bg-vivah-yellow text-vivah-green shadow-lg hover:scale-105 transition [&>svg]:h-6 [&>svg]:w-6"
			>
				<Fragment set:html={ChevronLeft} />
			</button>
			<button
				type="button"
				data-proxima
				aria-label="Próxima foto"
				class="absolute right-2 top-1/2 -translate-y-1/2 flex h-11 w-11 items-center justify-center rounded-full bg-vivah-yellow text-vivah-green shadow-lg hover:scale-105 transition [&>svg]:h-6 [&>svg]:w-6"
			>
				<Fragment set:html={ChevronRight} />
			</button>
		</div>
	</dialog>
</section>

<script>
	const secao = document.getElementById('projetos');
	const dialogo = document.getElementById('galeria') as HTMLDialogElement | null;
	const foto = document.getElementById('galeria-foto') as HTMLImageElement | null;
	const titulo = document.getElementById('galeria-titulo');
	const contador = document.getElementById('galeria-contador');
	let fotos: string[] = [];
	let indice = 0;
	let nomeProjeto = '';

	function mostrar(i: number) {
		if (!foto || fotos.length === 0) return;
		indice = (i + fotos.length) % fotos.length;
		foto.src = fotos[indice];
		foto.alt = `${nomeProjeto} — foto ${indice + 1} de ${fotos.length}`;
		if (contador) contador.textContent = `${indice + 1} / ${fotos.length}`;
	}

	// filtro por categoria
	const filtros = secao?.querySelectorAll<HTMLButtonElement>('[data-filtro]') ?? [];
	const itens = secao?.querySelectorAll<HTMLElement>('li[data-categoria]') ?? [];
	filtros.forEach((botao) =>
		botao.addEventListener('click', () => {
			filtros.forEach((b) => b.setAttribute('aria-selected', String(b === botao)));
			const filtro = botao.dataset.filtro;
			itens.forEach((item) => {
				item.hidden = filtro !== 'todos' && item.dataset.categoria !== filtro;
				item.classList.add('revealed');
			});
		})
	);

	// galeria
	secao?.querySelectorAll<HTMLButtonElement>('[data-galeria]').forEach((botao) =>
		botao.addEventListener('click', () => {
			fotos = JSON.parse(botao.dataset.galeria ?? '[]');
			nomeProjeto = botao.dataset.titulo ?? '';
			if (titulo) titulo.textContent = nomeProjeto;
			mostrar(0);
			dialogo?.showModal();
		})
	);
	dialogo?.querySelector('[data-anterior]')?.addEventListener('click', () => mostrar(indice - 1));
	dialogo?.querySelector('[data-proxima]')?.addEventListener('click', () => mostrar(indice + 1));
	dialogo?.querySelector('[data-fechar]')?.addEventListener('click', () => dialogo.close());
	dialogo?.addEventListener('click', (e) => {
		if (e.target === dialogo) dialogo.close();
	});
	dialogo?.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowLeft') mostrar(indice - 1);
		if (e.key === 'ArrowRight') mostrar(indice + 1);
	});

	// arrastar pro lado no celular
	let inicioX = 0;
	foto?.addEventListener('pointerdown', (e) => (inicioX = e.clientX));
	foto?.addEventListener('pointerup', (e) => {
		const delta = e.clientX - inicioX;
		if (Math.abs(delta) > 40) mostrar(indice + (delta < 0 ? 1 : -1));
	});
</script>
