---
const passos = [
	{
		numero: '01',
		titulo: 'Você solicita uma visita',
		texto: 'Chama no WhatsApp e agenda uma visita técnica gratuita, sem compromisso.',
	},
	{
		numero: '02',
		titulo: 'Fazemos o projeto sob medida',
		texto: 'Analisamos sua conta de luz e o espaço disponível pra dimensionar o sistema ideal.',
	},
	{
		numero: '03',
		titulo: 'Instalamos com equipe própria',
		texto: 'Equipe especializada faz a instalação com agilidade — projetos simples saem em poucos dias.',
	},
	{
		numero: '04',
		titulo: 'Você economiza, a gente acompanha',
		texto: 'Pós-venda de verdade: acompanhamos a geração e ficamos de prontidão se precisar.',
	},
];
---

<section id="como-funciona" class="py-20 md:py-28">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="text-center max-w-2xl mx-auto mb-14">
			<h2 class="font-display font-extrabold text-3xl md:text-4xl">Como funciona a energia solar</h2>
			<p class="mt-3 text-white/70">Do primeiro contato até a conta de luz mais leve — simples assim.</p>
		</div>

		<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
			{passos.map((passo) => (
				<div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-vivah-lime/50 transition-colors">
					<span class="font-display font-extrabold text-3xl text-vivah-lime">{passo.numero}</span>
					<h3 class="font-display font-bold text-lg mt-3 mb-2">{passo.titulo}</h3>
					<p class="text-sm text-white/70">{passo.texto}</p>
				</div>
			))}
		</div>
	</div>
</section>
