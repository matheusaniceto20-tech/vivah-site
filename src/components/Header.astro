---
import { linkWhatsApp } from '../lib/negocio';

interface Props {
	/** começa transparente por cima do hero e fica sólido ao rolar */
	transparent?: boolean;
}

const { transparent = false } = Astro.props;

const navLinks = [
	{ href: '/#como-funciona', label: 'Como funciona' },
	{ href: '/#simulador', label: 'Simulador' },
	{ href: '/#projetos', label: 'Projetos' },
	{ href: '/#avaliacoes', label: 'Avaliações' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/#contato', label: 'Contato' },
];
---

<header
	data-header
	data-transparent={String(transparent)}
	class="fixed top-0 inset-x-0 z-40 bg-vivah-green/95 backdrop-blur-md shadow-lg shadow-black/10 transition-[background-color,box-shadow] duration-300"
>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16 md:h-20">
		<a href="/" class="shrink-0" aria-label="Vivah Energia Solar — início">
			<img
				src="/brand/logo-vivah-horizontal.svg"
				alt="Vivah Energia Solar"
				width="152"
				height="56"
				class="h-11 md:h-14 w-auto"
			/>
		</a>

		<nav class="hidden lg:flex items-center gap-7 font-medium text-sm text-white" aria-label="Principal">
			{
				navLinks.map((link) => (
					<a
						href={link.href}
						class="relative py-1 hover:text-vivah-yellow transition-colors after:absolute after:left-0 after:-bottom-0.5 after:h-0.5 after:w-0 after:rounded-full after:bg-vivah-yellow after:transition-all after:duration-300 hover:after:w-full"
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<a
			href={linkWhatsApp()}
			target="_blank"
			rel="noopener noreferrer"
			class="btn btn-amarelo hidden lg:inline-flex !px-5 !py-2.5 text-sm"
		>
			Solicite uma visita
		</a>

		<button
			id="menu-toggle"
			class="lg:hidden p-2 -mr-2 text-white"
			aria-label="Abrir menu"
			aria-expanded="false"
			aria-controls="mobile-menu"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
		</button>
	</div>

	<div id="mobile-menu" hidden class="lg:hidden border-t border-white/10 bg-vivah-green">
		<nav class="flex flex-col px-4 py-4 gap-4 font-medium text-white" aria-label="Menu">
			{
				navLinks.map((link) => (
					<a href={link.href} class="hover:text-vivah-yellow transition-colors">
						{link.label}
					</a>
				))
			}
			<a href={linkWhatsApp()} target="_blank" rel="noopener noreferrer" class="btn btn-amarelo text-sm">
				Solicite uma visita
			</a>
		</nav>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-header]');
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');

	const fechar = () => {
		menu?.setAttribute('hidden', '');
		toggle?.setAttribute('aria-expanded', 'false');
		header?.classList.remove('menu-aberto');
	};

	toggle?.addEventListener('click', () => {
		if (menu?.hasAttribute('hidden')) {
			menu.removeAttribute('hidden');
			toggle.setAttribute('aria-expanded', 'true');
			header?.classList.add('menu-aberto');
		} else {
			fechar();
		}
	});
	menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', fechar));
</script>
