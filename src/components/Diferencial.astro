---
import { Image } from 'astro:assets';
import { Sun, MapPin } from 'lucide-static';
import usina from '../assets/brand/usina-vivah.jpg';
import { negocio } from '../lib/negocio';

const itens = [
	{
		icone: Sun,
		titulo: 'Usina própria de geração',
		texto:
			'Diferente de quem só instala, a Vivah tem usina própria pra distribuição de energia: mais controle sobre qualidade e prazo, do projeto à entrega.',
	},
	{
		icone: MapPin,
		titulo: 'Atendimento regional',
		texto: `Atendemos ${negocio.raioAtendimento}, não só a capital. Se você está no Tocantins ou na região, a gente chega.`,
	},
];
---

<section id="diferenciais" class="relative overflow-hidden bg-vivah-green py-20 md:py-28 text-white scroll-mt-20">
	<img
		src="/brand/logo-vivah-icone.svg"
		alt=""
		aria-hidden="true"
		class="pointer-events-none absolute -left-40 -bottom-40 w-[520px] opacity-[0.07] spin-slow"
	/>

	<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-12 items-center">
		<figure class="relative" data-reveal="left">
			<Image
				src={usina}
				alt="Obra da usina própria da Vivah, vista de drone"
				widths={[600, 1000]}
				sizes="(min-width: 1024px) 50vw, 100vw"
				class="w-full h-auto aspect-[4/3] object-cover rounded-3xl shadow-2xl"
			/>
			<figcaption class="absolute left-4 bottom-4 rounded-full bg-vivah-yellow px-4 py-1.5 text-xs font-bold text-vivah-green">
				Obra da usina própria da Vivah
			</figcaption>
		</figure>

		<div data-reveal="right">
			<span class="inline-block mb-4 rounded-full bg-white/10 px-3.5 py-1.5 text-xs font-bold uppercase tracking-[0.18em] text-vivah-yellow">
				Diferenciais
			</span>
			<h2 class="font-display font-extrabold text-3xl md:text-5xl leading-tight">
				O que diferencia a <span class="text-vivah-yellow">Vivah</span>
			</h2>
			<div class="mt-8 space-y-5">
				{
					itens.map((item) => (
						<div class="flex gap-4 rounded-2xl bg-white/5 p-5 ring-1 ring-white/10">
							<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-vivah-yellow text-vivah-green [&>svg]:h-6 [&>svg]:w-6">
								<Fragment set:html={item.icone} />
							</span>
							<div>
								<h3 class="font-display font-bold text-xl text-vivah-yellow">{item.titulo}</h3>
								<p class="mt-1 text-sm text-white/80">{item.texto}</p>
							</div>
						</div>
					))
				}
			</div>
			<a href="#simulador" class="btn btn-amarelo mt-8">Simular minha economia</a>
		</div>
	</div>
</section>
