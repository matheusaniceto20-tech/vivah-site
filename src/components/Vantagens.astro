---
import { Zap, Leaf, House, FileCheck, Sun, Handshake } from 'lucide-static';

const vantagens = [
	{ icone: Zap, titulo: 'Conta de luz bem menor', texto: 'Dependendo do consumo, a economia pode chegar a 80% da conta.' },
	{ icone: Leaf, titulo: 'Energia limpa', texto: 'Renovável, silenciosa e sem emissão de poluentes.' },
	{ icone: House, titulo: 'Imóvel mais valorizado', texto: 'Casa ou empresa com energia solar vale mais no mercado.' },
	{ icone: FileCheck, titulo: 'Sem burocracia', texto: 'A gente cuida da homologação com a distribuidora.' },
	{ icone: Sun, titulo: 'Usina própria', texto: 'Diferencial da Vivah: temos usina própria de geração solar.' },
	{ icone: Handshake, titulo: 'Pós-venda de verdade', texto: 'Acompanhamos a geração do seu sistema depois da instalação.' },
];
---

<section class="py-20 md:py-28 bg-white fundo-aurora">
	<img
		src="/brand/logo-vivah-icone.svg"
		alt=""
		aria-hidden="true"
		class="pointer-events-none absolute -left-28 -bottom-28 w-96 opacity-[0.06] spin-slow"
	/>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="text-center max-w-2xl mx-auto mb-14" data-reveal>
			<span class="eyebrow">Vantagens</span>
			<h2 class="titulo-secao">Por que colocar <span class="marker">energia solar</span></h2>
		</div>

		<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
			{
				vantagens.map((v, i) => {
					const placa = i % 3 === 1;
					return (
						<div
							class:list={[
								'group rounded-3xl p-7 ring-1 ring-transparent transition duration-300 hover:shadow-xl hover:-translate-y-1',
								placa ? 'cartao-placa-solar hover:ring-slate-300' : 'cartao-painel bg-vivah-mist/70 hover:bg-white hover:ring-vivah-yellow',
							]}
							data-reveal
							style={`--reveal-delay:${(i % 3) * 100}ms`}
						>
							<span class="icone-vivo flex h-14 w-14 items-center justify-center rounded-2xl bg-vivah-yellow text-vivah-green shadow-md shadow-vivah-star/30 transition duration-500 group-hover:rotate-[-8deg] group-hover:scale-110 [&>svg]:h-7 [&>svg]:w-7">
								<Fragment set:html={v.icone} />
							</span>
							<h3 class:list={['font-display font-bold text-xl mt-5 mb-2', placa ? 'text-white' : 'text-vivah-ink']}>{v.titulo}</h3>
							<p class:list={['text-sm', placa ? 'text-white/75' : 'text-vivah-muted']}>{v.texto}</p>
						</div>
					);
				})
			}
		</div>
	</div>
</section>
