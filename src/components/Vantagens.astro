---
import { Zap, Leaf, House, FileCheck, Sun, Handshake } from 'lucide-static';

const vantagens = [
	{ icone: Zap, titulo: 'Conta de luz bem menor', texto: 'Dependendo do consumo, a economia pode chegar a 80% da conta.' },
	{ icone: Leaf, titulo: 'Energia limpa', texto: 'Renovável, silenciosa e sem emissão de poluentes.' },
	{ icone: House, titulo: 'Imóvel mais valorizado', texto: 'Casa ou empresa com energia solar vale mais no mercado.' },
	{ icone: FileCheck, titulo: 'Sem burocracia', texto: 'A gente cuida da homologação com a distribuidora.' },
	{ icone: Sun, titulo: 'Usina própria', texto: 'Diferencial da Vivah: temos usina própria de geração solar.' },
	{ icone: Handshake, titulo: 'Pós-venda de verdade', texto: 'Acompanhamos a geração do seu sistema depois da instalação.' },
];
---

<section class="py-20 md:py-28 bg-white">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="text-center max-w-2xl mx-auto mb-14" data-reveal>
			<span class="eyebrow">Vantagens</span>
			<h2 class="titulo-secao">Por que colocar <span class="marker">energia solar</span></h2>
		</div>

		<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
			{
				vantagens.map((v, i) => (
					<div
						class="group rounded-3xl bg-vivah-mist/70 p-7 ring-1 ring-transparent transition duration-300 hover:bg-white hover:ring-vivah-yellow hover:shadow-xl hover:-translate-y-1"
						data-reveal
						style={`--reveal-delay:${(i % 3) * 100}ms`}
					>
						<span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-vivah-yellow text-vivah-green shadow-md shadow-vivah-star/30 transition duration-500 group-hover:rotate-[-8deg] group-hover:scale-110 [&>svg]:h-7 [&>svg]:w-7">
							<Fragment set:html={v.icone} />
						</span>
						<h3 class="font-display font-bold text-xl mt-5 mb-2 text-vivah-ink">{v.titulo}</h3>
						<p class="text-sm text-vivah-muted">{v.texto}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
