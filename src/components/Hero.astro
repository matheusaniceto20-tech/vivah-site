---
import heroPoster from '../assets/brand/hero-poster.jpg';
import { linkWhatsApp, negocio } from '../lib/negocio';

const nota = negocio.notaGoogle.toFixed(1).replace('.', ',');
---

<section class="relative min-h-[100svh] w-full overflow-hidden flex items-center pt-20 pb-24">
	<video
		class="absolute inset-0 w-full h-full object-cover"
		autoplay
		muted
		loop
		playsinline
		preload="metadata"
		poster={heroPoster.src}
		aria-hidden="true"
	>
		<source src="/videos/hero-usina-naval.mp4" type="video/mp4" />
	</video>

	<div class="absolute inset-0 bg-gradient-to-b from-vivah-green/85 via-vivah-green/45 to-vivah-green/90"></div>

	<div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center text-white">
		<a
			href="#avaliacoes"
			class="hero-in inline-flex items-center gap-2 rounded-full bg-white/10 ring-1 ring-white/25 backdrop-blur px-4 py-1.5 text-sm hover:bg-white/20 transition"
		>
			<span class="text-vivah-yellow tracking-wider" aria-hidden="true">★★★★★</span>
			<span><strong>{nota}</strong> no Google · {negocio.avaliacoesGoogle} avaliações</span>
		</a>

		<h1
			class="hero-in [--hero-delay:120ms] mt-6 font-display font-extrabold text-4xl sm:text-5xl md:text-6xl leading-[1.05]"
		>
			Transforme o sol em <span class="text-vivah-yellow">economia</span> na sua conta de luz
		</h1>

		<p class="hero-in [--hero-delay:240ms] mt-5 text-lg md:text-xl text-white/85 max-w-2xl mx-auto">
			Instalação, manutenção e projetos de energia solar e elétrica em Palmas e região, com usina própria
			de geração.
		</p>

		<div class="hero-in [--hero-delay:360ms] mt-9 flex flex-col sm:flex-row items-center justify-center gap-4">
			<a href="#simulador" class="btn btn-amarelo w-full sm:w-auto">Simular minha economia</a>
			<a href={linkWhatsApp()} target="_blank" rel="noopener noreferrer" class="btn btn-claro w-full sm:w-auto">
				Falar no WhatsApp
			</a>
		</div>
	</div>

	<a
		href="#numeros"
		aria-label="Rolar para baixo"
		class="absolute bottom-20 left-1/2 -ml-4 text-white/70 hover:text-white float"
	>
		<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"></path>
		</svg>
	</a>
</section>
