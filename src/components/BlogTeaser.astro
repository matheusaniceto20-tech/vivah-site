---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
	.slice(0, 3);
---

{posts.length > 0 && (
	<section class="py-20 md:py-28 bg-vivah-green-dark-2">
		<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
			<div class="flex items-center justify-between mb-10">
				<h2 class="font-display font-extrabold text-3xl md:text-4xl">Do blog</h2>
				<a href="/blog" class="text-sm text-vivah-yellow font-semibold hover:underline">Ver todos →</a>
			</div>
			<div class="grid sm:grid-cols-3 gap-6">
				{posts.map((post) => (
					<a href={`/blog/${post.id}`} class="block bg-vivah-green-dark border border-white/10 rounded-2xl p-6 hover:border-vivah-lime/40 transition-colors">
						<h3 class="font-display font-bold text-lg mb-2">{post.data.title}</h3>
						<p class="text-sm text-white/70">{post.data.description}</p>
					</a>
				))}
			</div>
		</div>
	</section>
)}
