---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
	.slice(0, 3);
---

{
	posts.length > 0 && (
		<section class="py-20 md:py-28 bg-vivah-mist fundo-aurora">
			<img
				src="/brand/logo-vivah-icone.svg"
				alt=""
				aria-hidden="true"
				class="pointer-events-none absolute -right-24 -top-24 w-80 opacity-[0.07] spin-slow"
			/>
			<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
				<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10" data-reveal>
					<div>
						<span class="eyebrow">Blog</span>
						<h2 class="titulo-secao">
							Aprenda sobre <span class="marker">energia solar</span>
						</h2>
					</div>
					<a href="/blog" class="font-semibold text-vivah-green-700 hover:underline">
						Ver todos os artigos →
					</a>
				</div>
				<div class="grid sm:grid-cols-3 gap-6">
					{posts.map((post, i) => (
						<a
							href={`/blog/${post.id}`}
							class="cartao-painel block rounded-3xl bg-white p-6 ring-1 ring-black/5 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:ring-vivah-yellow transition duration-300"
							data-reveal
							style={`--reveal-delay:${i * 100}ms`}
						>
							<p class="text-xs text-vivah-muted mb-2">
								{post.data.publishedAt.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}
							</p>
							<h3 class="font-display font-bold text-lg text-vivah-ink mb-2">{post.data.title}</h3>
							<p class="text-sm text-vivah-muted">{post.data.description}</p>
							<span class="inline-block mt-4 text-sm font-semibold text-vivah-green-700">Ler artigo →</span>
						</a>
					))}
				</div>
			</div>
		</section>
	)
}
