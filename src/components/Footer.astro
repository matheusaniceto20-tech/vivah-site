---
import { negocio, linkWhatsApp } from '../lib/negocio';

const ano = new Date().getFullYear();
const navegacao = [
	{ href: '/#como-funciona', label: 'Como funciona' },
	{ href: '/#simulador', label: 'Simulador' },
	{ href: '/#projetos', label: 'Projetos' },
	{ href: '/#avaliacoes', label: 'Avaliações' },
	{ href: '/blog', label: 'Blog' },
];
---

<footer class="bg-vivah-green text-white">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14 grid gap-10 md:grid-cols-4">
		<div class="md:col-span-2">
			<img
				src="/brand/logo-vivah-horizontal.svg"
				alt="Vivah Energia Solar"
				width="163"
				height="60"
				class="h-15 w-auto mb-4"
				loading="lazy"
			/>
			<p class="text-white/70 text-sm max-w-sm">
				Energia solar e elétrica em {negocio.cidade}, com usina própria de geração e atendimento em
				{negocio.raioAtendimento}.
			</p>
			<a
				href={negocio.googlePerfilUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="mt-5 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm hover:bg-white/15 transition"
			>
				<span class="text-vivah-yellow" aria-hidden="true">★★★★★</span>
				{negocio.notaGoogle.toFixed(1).replace('.', ',')} no Google
			</a>
		</div>

		<div>
			<h3 class="font-display font-bold text-vivah-yellow mb-3">Contato</h3>
			<ul class="space-y-2 text-sm text-white/80">
				<li>
					<a href={linkWhatsApp()} target="_blank" rel="noopener noreferrer" class="hover:text-vivah-yellow">
						WhatsApp: {negocio.telefone}
					</a>
				</li>
				<li>
					<a href={negocio.instagramUrl} target="_blank" rel="noopener noreferrer" class="hover:text-vivah-yellow">
						Instagram: {negocio.instagram}
					</a>
				</li>
				<li>{negocio.cidade}</li>
			</ul>
		</div>

		<div>
			<h3 class="font-display font-bold text-vivah-yellow mb-3">Navegação</h3>
			<ul class="space-y-2 text-sm text-white/80">
				{
					navegacao.map((item) => (
						<li>
							<a href={item.href} class="hover:text-vivah-yellow">
								{item.label}
							</a>
						</li>
					))
				}
				<li>
					<a href="/privacidade" class="hover:text-vivah-yellow">Política de privacidade</a>
				</li>
			</ul>
		</div>
	</div>

	<div class="border-t border-white/10 py-5 px-4">
		<p class="text-center text-xs text-white/50">
			© {ano} {negocio.razaoSocial} · CNPJ {negocio.cnpj}
		</p>
	</div>
</footer>
