---
import { negocio } from '../lib/negocio';

// Avaliações reais do Google (coletadas em 11/09/2026 — ver captura em _memoria/estrategia.md)
const depoimentos = [
	{
		nome: 'Jahiny Guimaraes',
		texto: 'Pré e pós venda de excelência! Empresa realmente comprometida com o cliente e o trabalho desempenhado! Vale toda a confiança!',
	},
	{
		nome: 'Joana Cardoso',
		texto: 'Vim avaliar após um ano de instalação da minha energia solar, nunca tive nenhum problema e sempre tive um excelente atendimento no pós-venda que para mim é fundamental! Super recomendo.',
	},
	{
		nome: 'Eduardo Bitencourt',
		texto: 'Pessoal de prontidão, responsáveis, e extremamente profissionais na área de atuação. Recomendo de olhos fechados!',
	},
	{
		nome: 'fabio jardim barros',
		texto: 'Produto excelente! Manutenção, acompanhamento, qualidade das placas e nos inversores. 100% confiável.',
	},
	{
		nome: 'Gustavo Oliveira',
		texto: 'Excelente atendimento! O suporte do pós venda é um grande diferencial. Entrega o que é proposto.',
	},
	{
		nome: 'Luciana Sara Sarah',
		texto: 'A melhor de Palmas. Atendimento e pós venda maravilhosa.',
	},
];
---

<section class="py-20 md:py-28 bg-vivah-green-dark-2">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="text-center max-w-2xl mx-auto mb-4">
			<div class="flex items-center justify-center gap-2 text-vivah-yellow text-xl mb-2">
				{'★★★★★'}
			</div>
			<h2 class="font-display font-extrabold text-3xl md:text-4xl">
				Nota {negocio.notaGoogle.toFixed(1)} no Google
			</h2>
			<p class="mt-2 text-white/70">{negocio.avaliacoesGoogle} avaliações reais de quem já instalou com a gente.</p>
		</div>

		<div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
			{depoimentos.map((d) => (
				<div class="bg-vivah-green-dark rounded-2xl p-6 border border-white/10">
					<div class="text-vivah-yellow text-sm mb-3">{'★★★★★'}</div>
					<p class="text-sm text-white/80 mb-4">"{d.texto}"</p>
					<p class="font-semibold text-sm">{d.nome}</p>
				</div>
			))}
		</div>
	</div>
</section>
