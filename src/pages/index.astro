---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Numeros from '../components/Numeros.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Simulador from '../components/Simulador.astro';
import Vantagens from '../components/Vantagens.astro';
import Diferencial from '../components/Diferencial.astro';
import Solucoes from '../components/Solucoes.astro';
import Portfolio from '../components/Portfolio.astro';
import Avaliacoes from '../components/Avaliacoes.astro';
import CtaFaixa from '../components/CtaFaixa.astro';
import BlogTeaser from '../components/BlogTeaser.astro';
import Faq from '../components/Faq.astro';
import ContatoMapa from '../components/ContatoMapa.astro';
import Emenda from '../components/Emenda.astro';
---

<Layout
	title="Vivah Energia Solar — Energia solar em Palmas e região"
	description="Instalação, manutenção e projetos de energia solar e elétrica em Palmas-TO e região. Usina própria de geração, nota 5,0 no Google. Simule sua economia."
	heroHeader
>
	<Hero />
	<Numeros />
	<ComoFunciona />
	<Emenda />
	<Simulador />
	<Emenda />
	<Vantagens />
	<Emenda baixoClaro={false} />
	<Diferencial />
	<Emenda cimaClaro={false} />
	<Solucoes />
	<Emenda />
	<Portfolio />
	<Emenda />
	<Avaliacoes />
	<CtaFaixa />
	<BlogTeaser />
	<Emenda />
	<Faq />
	<Emenda />
	<ContatoMapa />
</Layout>
