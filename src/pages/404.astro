---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página não encontrada" description="Página não encontrada.">
	<section class="py-32 text-center px-4">
		<h1 class="font-display font-extrabold text-4xl mb-4">404</h1>
		<p class="text-white/75">Essa página não existe.</p>
		<a href="/" class="mt-8 inline-flex items-center gap-2 bg-vivah-yellow text-vivah-green-dark font-bold px-7 py-3.5 rounded-full">
			Voltar pro início
		</a>
	</section>
</Layout>
