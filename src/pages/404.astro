---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página não encontrada" description="Página não encontrada.">
	<section class="py-24 md:py-32 px-4 text-center bg-vivah-cream">
		<p class="font-display font-extrabold text-7xl text-vivah-green">404</p>
		<h1 class="titulo-secao mt-4">Essa página não existe</h1>
		<p class="mt-4 text-vivah-muted">O link pode ter mudado. Volta pro início que tá tudo lá.</p>
		<a href="/" class="btn btn-amarelo mt-8">Voltar pro início</a>
	</section>
</Layout>
