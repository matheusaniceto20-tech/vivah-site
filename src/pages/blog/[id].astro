---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { linkWhatsApp } from '../../lib/negocio';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
	<section class="py-12 md:py-16 bg-vivah-cream">
		<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
			<a href="/blog" class="text-sm font-semibold text-vivah-green-700 hover:underline">← Voltar pro blog</a>
			<p class="text-xs text-vivah-muted mt-6 mb-2">
				{post.data.publishedAt.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}
				· {post.data.author}
			</p>
			<h1 class="titulo-secao">{post.data.title}</h1>
		</div>
	</section>

	<article class="py-12 md:py-16 bg-white">
		<div
			class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 prose prose-lg prose-headings:font-display prose-headings:text-vivah-ink prose-a:text-vivah-green-700"
		>
			<Content />
		</div>

		<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 mt-14">
			<div class="rounded-3xl bg-vivah-yellow p-8 text-center">
				<p class="font-display font-bold text-2xl text-vivah-green">Ficou com alguma dúvida sobre o seu caso?</p>
				<div class="mt-5 flex flex-col sm:flex-row gap-3 justify-center">
					<a href="/#simulador" class="btn btn-verde">Fazer a simulação</a>
					<a
						href={linkWhatsApp(`Li o artigo "${post.data.title}" e quero saber mais.`)}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-contorno"
					>
						Falar no WhatsApp
					</a>
				</div>
			</div>
		</div>
	</article>
</Layout>
