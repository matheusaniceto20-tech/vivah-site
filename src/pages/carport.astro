---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { Image as ImageIcon, CarFront, Sun, Ruler, Wallet, Leaf, ChevronDown } from 'lucide-static';
import { linkWhatsApp } from '../lib/negocio';
import { projetos } from '../data/projetos';

const carports = projetos.filter((p) => p.categoria === 'carport');
const capa = carports[0]?.fotos[0];

const beneficios = [
	{ icone: CarFront, titulo: 'Protege os veículos', texto: 'Sol, chuva e granizo não chegam nos carros embaixo da estrutura.' },
	{ icone: Sun, titulo: 'Gera energia ao mesmo tempo', texto: 'A mesma estrutura que cobre a garagem gera a energia que abastece o imóvel.' },
	{ icone: Ruler, titulo: 'Aproveita espaço que já existe', texto: 'Não precisa de área extra: o estacionamento vira também gerador de energia.' },
	{ icone: Wallet, titulo: 'Reduz a conta de luz', texto: 'Mesmo benefício de um sistema convencional, com a vantagem de cobrir os carros.' },
	{ icone: ImageIcon, titulo: 'Valoriza o imóvel', texto: 'Estacionamento coberto e com geração própria é diferencial em qualquer avaliação.' },
	{ icone: Leaf, titulo: 'Energia limpa', texto: 'Mesma energia renovável de qualquer sistema fotovoltaico da Vivah.' },
];

const etapas = [
	'Visita técnica e projeto da estrutura',
	'Preparação do local e fundação',
	'Montagem da estrutura metálica',
	'Instalação dos módulos solares',
	'Conexão elétrica e homologação',
	'Entrega e acompanhamento',
];

const faq = [
	{
		p: 'Cabe quantos carros?',
		r: 'Depende do espaço disponível — desde uma vaga só até estacionamentos comerciais grandes, como o carport que fizemos pra Naval, em Caseara.',
	},
	{ p: 'Serve pra empresa também?', r: 'Serve. É uma das soluções mais usadas em comércios, condomínios e empresas com estacionamento próprio.' },
	{ p: 'A estrutura aguenta o peso da chuva e do vento?', r: 'Sim, a estrutura é dimensionada na visita técnica considerando carga de vento e água da região.' },
	{ p: 'Dá pra colocar carregador de carro elétrico junto?', r: 'Dá. É um complemento comum num carport solar — a gente já projeta pensando nisso quando você quiser.' },
];
---

<Layout
	title="Instalação de Carport Solar"
	description="Carport com geração de energia solar em Palmas e região: protege os veículos e reduz a conta de luz ao mesmo tempo."
	heroHeader
>
	<section class="relative min-h-[70vh] flex items-end pt-24 pb-16 overflow-hidden">
		{
			capa && (
				<Image
					src={capa}
					alt="Carport com painéis solares instalado pela Vivah"
					widths={[800, 1600]}
					sizes="100vw"
					class="absolute inset-0 w-full h-full object-cover"
				/>
			)
		}
		<div class="absolute inset-0 bg-gradient-to-t from-vivah-green via-vivah-green/70 to-vivah-green/30"></div>
		<div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-white">
			<span class="eyebrow !bg-white/10 !text-vivah-yellow">Carport solar</span>
			<h1 class="font-display font-extrabold text-4xl md:text-6xl leading-tight">
				Cobertura pro carro. <span class="text-vivah-yellow">Energia pra casa.</span>
			</h1>
			<p class="mt-5 text-lg text-white/85 max-w-2xl">
				Uma estrutura só, dois benefícios: protege os veículos do sol e da chuva enquanto gera a energia que
				abastece o imóvel.
			</p>
			<div class="mt-8 flex flex-col sm:flex-row gap-4">
				<a href={linkWhatsApp('Quero um orçamento de carport solar.')} target="_blank" rel="noopener noreferrer" class="btn btn-amarelo">
					Pedir orçamento de carport
				</a>
				<a href="#projetos-carport" class="btn btn-claro">Ver projetos entregues</a>
			</div>
		</div>
	</section>

	<section class="py-20 md:py-28 bg-white">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="text-center max-w-2xl mx-auto mb-14" data-reveal>
				<span class="eyebrow">Vantagens</span>
				<h2 class="titulo-secao">Por que instalar um <span class="marker">carport solar</span></h2>
			</div>
			<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
				{
					beneficios.map((b, i) => (
						<div class="rounded-3xl bg-vivah-mist/70 p-7 ring-1 ring-transparent hover:bg-white hover:ring-vivah-yellow hover:shadow-xl hover:-translate-y-1 transition duration-300" data-reveal style={`--reveal-delay:${(i % 3) * 100}ms`}>
							<span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-vivah-yellow text-vivah-green [&>svg]:h-7 [&>svg]:w-7" set:html={b.icone} />
							<h3 class="font-display font-bold text-xl mt-5 mb-2 text-vivah-ink">{b.titulo}</h3>
							<p class="text-sm text-vivah-muted">{b.texto}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="py-20 md:py-28 bg-vivah-mist">
		<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
			<div class="text-center max-w-2xl mx-auto mb-14" data-reveal>
				<span class="eyebrow">Como funciona</span>
				<h2 class="titulo-secao">Da visita à <span class="marker">estrutura pronta</span></h2>
			</div>
			<ol class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
				{
					etapas.map((e, i) => (
						<li class="flex gap-4 rounded-2xl bg-white p-5 ring-1 ring-black/5" data-reveal style={`--reveal-delay:${i * 80}ms`}>
							<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-vivah-green font-display font-bold text-white">{i + 1}</span>
							<span class="text-sm text-vivah-ink pt-1.5">{e}</span>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	{
		carports.length > 0 && (
			<section id="projetos-carport" class="py-20 md:py-28 bg-white scroll-mt-20">
				<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
					<div class="text-center max-w-2xl mx-auto mb-12" data-reveal>
						<span class="eyebrow">Projetos</span>
						<h2 class="titulo-secao">Carports que a <span class="marker">Vivah</span> já entregou</h2>
					</div>
					<div class="grid md:grid-cols-2 gap-6">
						{carports.map((p) => (
							<div class="rounded-3xl overflow-hidden bg-vivah-mist ring-1 ring-black/5" data-reveal>
								<Image src={p.fotos[0]} alt={`Carport ${p.titulo}${p.local ? ' em ' + p.local : ''}`} widths={[500, 900]} sizes="(min-width: 768px) 50vw, 100vw" class="w-full aspect-[4/3] object-cover" />
								<div class="p-6">
									<h3 class="font-display font-bold text-xl">{p.titulo}</h3>
									{p.local && <p class="text-sm text-vivah-muted">{p.local}</p>}
								</div>
							</div>
						))}
					</div>
					<div class="text-center mt-10">
						<a href="/#projetos" class="font-semibold text-vivah-green-700 hover:underline">Ver todos os projetos →</a>
					</div>
				</div>
			</section>
		)
	}

	<section class="py-20 md:py-28 bg-vivah-mist">
		<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
			<h2 class="titulo-secao text-center mb-12">Perguntas sobre carport</h2>
			<div class="space-y-3">
				{
					faq.map((item) => (
						<details class="group rounded-2xl bg-white p-5 ring-1 ring-transparent open:ring-vivah-yellow open:shadow-lg transition">
							<summary class="flex items-center justify-between gap-4 cursor-pointer font-semibold list-none">
								{item.p}
								<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-vivah-yellow text-vivah-green [&>svg]:h-4 [&>svg]:w-4 group-open:rotate-180 transition-transform" set:html={ChevronDown} />
							</summary>
							<p class="mt-3 text-sm text-vivah-muted">{item.r}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<section class="bg-vivah-green py-16 text-center text-white">
		<h2 class="font-display font-extrabold text-3xl md:text-4xl">Quer um carport solar no seu espaço?</h2>
		<a href={linkWhatsApp('Quero um orçamento de carport solar.')} target="_blank" rel="noopener noreferrer" class="btn btn-amarelo mt-6">
			Pedir orçamento
		</a>
	</section>
</Layout>
