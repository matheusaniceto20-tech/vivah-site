---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { Sun, Wallet, Smartphone, ShieldCheck, ChevronDown } from 'lucide-static';
import { linkWhatsApp } from '../lib/negocio';
import { projetos } from '../data/projetos';
import FaqSchema from '../components/FaqSchema.astro';

const residenciais = projetos.filter((p) => p.categorias.includes('residencial')).slice(0, 6);

const beneficios = [
	{ icone: Wallet, titulo: 'Reduz a conta de luz', texto: 'Economia de até 80% na conta, dependendo do seu consumo e do tamanho do sistema.' },
	{ icone: Sun, titulo: 'Combina com o calor de Palmas', texto: 'Quanto mais ar-condicionado e ventilador rodando, mais sentido faz gerar a própria energia.' },
	{ icone: Smartphone, titulo: 'Acompanhamento pelo celular', texto: 'App de monitoramento mostra quanto o sistema está gerando em tempo real.' },
	{ icone: ShieldCheck, titulo: 'Homologação inclusa', texto: 'Cuidamos de todo o processo junto à Energisa — você não precisa correr atrás de nada.' },
];

const faq = [
	{
		p: 'Funciona em qualquer tipo de telhado?',
		r: 'A maioria dos telhados comporta — cerâmico, metálico, fibrocimento ou laje. A visita técnica avalia o estado da estrutura e define o melhor ponto de fixação pra cada caso.',
	},
	{
		p: 'Preciso pagar à vista?',
		r: 'Não. A maioria dos sistemas que instalamos é financiada, com parcela pensada pra caber no que você já paga de conta de luz hoje.',
	},
	{
		p: 'Quanto tempo leva pra instalar?',
		r: 'A instalação em si costuma levar poucos dias. O prazo maior é o da homologação junto à Energisa, que a gente também cuida.',
	},
	{
		p: 'E se eu me mudar de casa?',
		r: 'O sistema valoriza o imóvel — é comum ser um diferencial na venda. Se for imóvel alugado, também dá pra planejar isso com antecedência.',
	},
	{
		p: 'Precisa de manutenção?',
		r: 'Pouca. Painel solar não tem peça móvel — o que mais importa é limpeza periódica e checar o inversor de vez em quando.',
	},
];
---

<Layout
	title="Energia Solar Residencial em Palmas"
	description="Energia solar para sua casa em Palmas e região: economia na conta de luz, financiamento facilitado, homologação inclusa e pós-venda de verdade."
	heroHeader
>
	<section class="relative overflow-hidden bg-vivah-green py-28 md:py-36 text-white">
		<img src="/brand/logo-vivah-icone.svg" alt="" aria-hidden="true" class="pointer-events-none absolute -right-32 -top-32 w-96 opacity-10 spin-slow" />
		<div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
			<span class="eyebrow !bg-white/10 !text-vivah-yellow">Residencial</span>
			<h1 class="font-display font-extrabold text-4xl md:text-6xl leading-tight">
				Energia solar <span class="text-vivah-yellow">pra sua casa</span> em Palmas
			</h1>
			<p class="mt-5 text-lg text-white/85 max-w-2xl">
				Sistema dimensionado pro seu consumo real, com financiamento que cabe na conta, homologação inclusa e
				acompanhamento de verdade depois que a usina está no ar.
			</p>
			<a href={linkWhatsApp('Quero um orçamento de energia solar para minha casa.')} target="_blank" rel="noopener noreferrer" class="btn btn-amarelo mt-8">
				Simular minha economia
			</a>
		</div>
	</section>

	<section class="py-20 md:py-28 bg-white fundo-aurora">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="text-center max-w-2xl mx-auto mb-14" data-reveal>
				<span class="eyebrow">Vantagens</span>
				<h2 class="titulo-secao">Por que instalar <span class="marker">na sua casa</span></h2>
			</div>
			<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
				{
					beneficios.map((b, i) => (
						<div class="rounded-3xl bg-vivah-mist/70 p-7 hover:bg-white hover:shadow-xl hover:ring-1 hover:ring-vivah-yellow hover:-translate-y-1 transition duration-300" data-reveal style={`--reveal-delay:${i * 100}ms`}>
							<span class="icone-vivo flex h-14 w-14 items-center justify-center rounded-2xl bg-vivah-yellow text-vivah-green [&>svg]:h-7 [&>svg]:w-7" set:html={b.icone} />
							<h3 class="font-display font-bold text-lg mt-5 mb-1.5">{b.titulo}</h3>
							<p class="text-sm text-vivah-muted">{b.texto}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	{
		residenciais.length > 0 && (
			<section id="projetos-residencial" class="py-20 md:py-28 bg-vivah-mist scroll-mt-20">
				<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
					<div class="text-center max-w-2xl mx-auto mb-12" data-reveal>
						<span class="eyebrow">Projetos</span>
						<h2 class="titulo-secao">Casas que a <span class="marker">Vivah</span> já atendeu</h2>
					</div>
					<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
						{residenciais.map((p) => (
							<div class="rounded-3xl overflow-hidden bg-white ring-1 ring-black/5" data-reveal>
								<Image src={p.fotos[0]} alt={`Instalação residencial — ${p.titulo}`} widths={[400, 700]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" class="w-full aspect-[4/3] object-cover" />
								<div class="p-5">
									<h3 class="font-display font-bold text-lg">{p.titulo}</h3>
									{p.specs.length > 0 && <p class="text-sm text-vivah-muted">{p.specs.join(' · ')}</p>}
								</div>
							</div>
						))}
					</div>
					<div class="text-center mt-10">
						<a href="/#projetos" class="font-semibold text-vivah-green-700 hover:underline">Ver todos os projetos →</a>
					</div>
				</div>
			</section>
		)
	}

	<section class="py-20 md:py-28 bg-white">
		<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
			<h2 class="titulo-secao text-center mb-12">Perguntas sobre energia solar residencial</h2>
			<div class="space-y-3">
				{
					faq.map((item) => (
						<details class="group rounded-2xl bg-vivah-mist p-5 ring-1 ring-transparent open:bg-white open:ring-vivah-yellow open:shadow-lg transition">
							<summary class="flex items-center justify-between gap-4 cursor-pointer font-semibold list-none">
								{item.p}
								<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-vivah-yellow text-vivah-green [&>svg]:h-4 [&>svg]:w-4 group-open:rotate-180 transition-transform" set:html={ChevronDown} />
							</summary>
							<p class="mt-3 text-sm text-vivah-muted">{item.r}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<section class="bg-vivah-yellow py-16 text-center">
		<h2 class="font-display font-extrabold text-3xl md:text-4xl text-vivah-green">Quer saber quanto você economizaria?</h2>
		<a href={linkWhatsApp('Quero um orçamento de energia solar para minha casa.')} target="_blank" rel="noopener noreferrer" class="btn btn-verde mt-6">
			Simular minha economia
		</a>
	</section>

	<FaqSchema faq={faq} />
</Layout>
