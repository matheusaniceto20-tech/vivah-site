---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { negocio } from '../lib/negocio';

interface Props {
	title: string;
	description: string;
	/** header transparente por cima do hero (só na home) */
	heroHeader?: boolean;
}

const { title, description, heroHeader = false } = Astro.props;
const siteTitle = title.includes('Vivah') ? title : `${title} · Vivah Energia Solar`;

const localBusinessSchema = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	name: negocio.marca,
	legalName: negocio.razaoSocial,
	image: 'https://vivah-solar.netlify.app/brand/logo-vivah-horizontal.svg',
	url: 'https://vivah-solar.netlify.app',
	telephone: negocio.telefone,
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Palmas',
		addressRegion: 'TO',
		addressCountry: 'BR',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: negocio.localizacao.lat,
		longitude: negocio.localizacao.lng,
	},
	areaServed: {
		'@type': 'GeoCircle',
		geoMidpoint: {
			'@type': 'GeoCoordinates',
			latitude: negocio.localizacao.lat,
			longitude: negocio.localizacao.lng,
		},
		geoRadius: '300000',
	},
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: negocio.notaGoogle,
		reviewCount: negocio.avaliacoesGoogleSchema,
	},
	sameAs: [negocio.instagramUrl],
};
---

<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{siteTitle}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#003000" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-8DKYGMZMTR"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', 'G-8DKYGMZMTR');
		</script>

		<script is:inline>
			document.documentElement.classList.add('js');
			// se o script de efeitos não carregar, mostra o conteúdo mesmo assim
			window.addEventListener('load', function () {
				setTimeout(function () {
					if (window.__vivahFx) return;
					document.querySelectorAll('[data-reveal]').forEach(function (el) {
						el.classList.add('revealed');
					});
				}, 1500);
			});
		</script>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="bg-white text-vivah-ink antialiased">
		<Header transparent={heroHeader} />
		{!heroHeader && <div class="h-16 md:h-20" aria-hidden="true"></div>}
		<main>
			<slot />
		</main>
		<Footer />
		<WhatsAppFloat />

		<script>
			import { iniciarEfeitos } from '../lib/efeitos';
			iniciarEfeitos();
		</script>
	</body>
</html>
